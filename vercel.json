{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=6144 npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/catalog/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/products/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/categories/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/clients/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/brands/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/promo-cards/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/hero/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/tienda/producto/:slug",
      "destination": "/tienda/:slug",
      "permanent": true
    },
    {
      "source": "/categoria/software",
      "destination": "/software",
      "permanent": true
    },
    {
      "source": "/categoria/toner-compatibles",
      "destination": "/categoria/toner-suministros",
      "permanent": true
    },
    {
      "source": "/registro",
      "destination": "/login/registro",
      "permanent": true
    },
    {
      "source": "/qtc",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/qtc/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/404",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/soluciones",
      "destination": "/servicios",
      "permanent": true
    },
    {
      "source": "/soluciones/:path*",
      "destination": "/servicios",
      "permanent": true
    },
    {
      "source": "/product/:path*",
      "destination": "/tienda",
      "permanent": true
    },
    {
      "source": "/productos/:path*",
      "destination": "/tienda",
      "permanent": true
    },
    {
      "source": "/shop/:path*",
      "destination": "/tienda",
      "permanent": true
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-content/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/categoria/multifuncionales",
      "has": [{ "type": "query", "key": "sub", "value": "all" }],
      "destination": "/categoria/multifuncionales?sub=todas",
      "permanent": true
    },
    {
      "source": "/categoria/multifuncionales",
      "missing": [{ "type": "query", "key": "sub" }],
      "destination": "/categoria/multifuncionales?sub=todas",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/|assets/|.*\\..*).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
